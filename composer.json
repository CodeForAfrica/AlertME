{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "~8.3.36",
        "algolia/algoliasearch-client-php": "4.50.0",
        "graham-campbell/markdown": "14.0.0",
        "laravel/framework": "8.83.29",
        "laravel/helpers": "1.8.3",
        "laravel/scout": "9.8.0",
        "laravel/tinker": "2.11.1",
        "laravel/ui": "3.4.6",
        "nesbot/carbon": "2.73.0",
        "pda/pheanstalk": "4.0.5",
        "symfony/http-client": "5.4.54",
        "fabpot/goutte": "4.0.3",
        "doctrine/dbal": "2.13.9"
    },
    "require-dev": {
        "fakerphp/faker": "1.24.1",
        "mockery/mockery": "1.6.15",
        "phpunit/phpunit": "9.6.38"
    },
    "autoload": {
        "classmap": [
            "database"
        ],
        "psr-4": {
            "AlertME\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.36"
        }
    }
}
